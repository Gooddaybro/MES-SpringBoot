# Copy to ../.local/agent.env. Never commit the populated file.
MES_AGENT_ENABLED=true
MES_AGENT_BASE_URL=http://127.0.0.1:8001
# Start-Agent.ps1 generates this on first creation; both services use the same value.
MES_AGENT_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MES_AGENT_CONNECT_TIMEOUT_MS=3000
MES_AGENT_READ_TIMEOUT_MS=35000
AGENT_HOST=127.0.0.1
AGENT_PORT=8001
AGENT_REQUEST_TIMEOUT_SECONDS=30

# Optional chat generation: leave blank to use real retrieved source excerpts.
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_MODEL=deepseek-flash
AGENT_LLM_TIMEOUT_SECONDS=15
DEEPSEEK_API_KEY=

# Jina is a separate embeddings provider. Chunking stays local.
JINA_API_KEY=
AGENT_EMBEDDING_BASE_URL=https://api.jina.ai/v1/embeddings
AGENT_EMBEDDING_MODEL=jina-embeddings-v3
AGENT_EMBEDDING_DIMENSIONS=512
AGENT_EMBEDDING_TIMEOUT_SECONDS=20
AGENT_EMBEDDING_BATCH_SIZE=24
AGENT_MIN_SIMILARITY=0.38
AGENT_TOP_K=5
AGENT_MAX_CONTEXT_CHARACTERS=6000
# Defaults are agent/data and the repository parent's pdf文档 directory.
# AGENT_DATA_DIR=D:/your-private-index
# AGENT_PDF_DIR=D:/your-approved-pdfs
